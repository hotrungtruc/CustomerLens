# Môi trường chạy Database
# Đặt "true" để sử dụng Supabase PostgreSQL
# Đặt "false" để sử dụng SQLite local (trong thư mục data/)
USE_SUPABASE=false

# Chuỗi kết nối Database Supabase (Connection String)
# Copy từ Dashboard Supabase -> Settings -> Database -> Connection string (URI)
# LƯU Ý:
# 1. Thay [YOUR-PASSWORD] bằng mật khẩu thật của bạn
# 2. Giữ nguyên cổng 6543 (PgBouncer/Transaction Pooler) nhưng không thêm tham số ?pgbouncer=true vì psycopg2 có thể báo lỗi
SUPABASE_URL="postgresql://postgres.[YOUR_PROJECT_ID]:[YOUR-PASSWORD]@[REGION].pooler.supabase.com:6543/postgres"

# Mật khẩu khởi tạo khi Seed Data (để trống sẽ dùng giá trị mặc định "change_me_immediately")
ADMIN_PASSWORD="admin_secure_password"
MOD_PASSWORD="mod_secure_password"
