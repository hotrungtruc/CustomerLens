# Môi trường chạy Database
# Đặt "true" để sử dụng Supabase PostgreSQL
# Đặt "false" để sử dụng SQLite local (trong thư mục data/)
USE_SUPABASE=false

# Chuỗi kết nối Database Supabase (Connection String)
# Copy từ Dashboard Supabase -> Settings -> Database -> Connection string (URI)
# LƯU Ý:
# 1. Thay [YOUR-PASSWORD] bằng mật khẩu thật của bạn
# 2. Giữ nguyên cổng 6543 (PgBouncer/Transaction Pooler) nhưng không thêm tham số ?pgbouncer=true vì psycopg2 có thể báo lỗi
SUPABASE_URL="postgresql://postgres.[YOUR_PROJECT_ID]:[YOUR-PASSWORD]@[REGION].pooler.supabase.com:6543/postgres"

# Mật khẩu khởi tạo khi Seed Data (để trống sẽ dùng giá trị mặc định "change_me_immediately")
ADMIN_PASSWORD="admin_secure_password"
MOD_PASSWORD="mod_secure_password"

# Cấu hình Redis Pub/Sub cho WebSocket và Queue
# Master node: REDIS_URL=redis://redis:6379/0
# Worker node: REDIS_URL=redis://<MASTER_PRIVATE_IP>:6379/0
REDIS_URL="redis://redis:6379/0"

# Cookie device identity: true trên HTTPS production, false khi chạy HTTP local.
# Nếu bỏ trống, backend tự suy ra từ scheme của request.
DEVICE_COOKIE_SECURE="true"

# Danh sách Origin được phép mở publisher WebSocket, phân tách bằng dấu phẩy.
WS_ALLOWED_ORIGINS="https://checkinface.me,https://www.checkinface.me,https://face-recognition-system-coral.vercel.app,http://localhost:3000,http://127.0.0.1:3000"

# Presence lease: TTL phải lớn hơn chu kỳ renew.
CAMERA_PRESENCE_TTL_SECONDS=15
CAMERA_PRESENCE_RENEW_SECONDS=5

# Pairing/recovery khi device_token bị mất.
PAIRING_CODE_TTL_SECONDS=600
PAIRING_CLAIM_LIMIT=10
PAIRING_CLAIM_WINDOW_SECONDS=600

# Giới hạn JPEG binary trên publisher WebSocket (2 MiB).
MAX_CAMERA_FRAME_BYTES=2097152

# JWT Asymmetric RS256 Authentication Keys (Production)
# Khuyến nghị: Đặt trực tiếp qua biến môi trường để đồng bộ giữa các container và tránh mất session khi restart.
# Có thể truyền PEM string (có thể thay xuống dòng bằng \n) hoặc Base64 encoded.
# JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# JWT_EXPIRATION_MINUTES=480

# CẢNH BÁO BẢO MẬT:
# Không bao giờ commit file .env.production hoặc bất kỳ file chứa credentials thật vào repository.
# Đảm bảo .env.production luôn nằm trong .gitignore.
