# CustomerLens Production EC2 Environment Variables

# Database Mode (true for Supabase PostgreSQL, false for embedded SQLite)
USE_SUPABASE=false

# Default Admin & Moderator Passwords for Seed Data
ADMIN_PASSWORD="admin123"
MOD_PASSWORD="moderator123"

# Inter-node Messaging (Master Private IP in AWS VPC)
REDIS_URL="redis://172.31.9.172:6379/0"
KAFKA_BOOTSTRAP_SERVERS="172.31.9.172:9092"

# Security & CORS
DEVICE_COOKIE_SECURE="false"
WS_ALLOWED_ORIGINS="http://15.134.121.250,http://15.134.121.250:3000,http://15.134.121.250:8000,http://localhost:3000,http://localhost:8000"

# Camera Presence Lease
CAMERA_PRESENCE_TTL_SECONDS=15
CAMERA_PRESENCE_RENEW_SECONDS=5

# Pairing Code TTL
PAIRING_CODE_TTL_SECONDS=600
PAIRING_CLAIM_LIMIT=10
PAIRING_CLAIM_WINDOW_SECONDS=600

# Max JPEG Payload
MAX_CAMERA_FRAME_BYTES=2097152
