# ============================================================
# .env.production — Môi trường EC2 Production
# Copy file này lên EC2 Master tại: /home/ubuntu/CustomerLens/backend/.env
# KHÔNG commit file này lên git!
# ============================================================

# ── Database ─────────────────────────────────────────────────
# Đặt "true" nếu dùng Supabase PostgreSQL, "false" để dùng SQLite local
USE_SUPABASE=true

# Supabase connection string
SUPABASE_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
SUPABASE_API_URL="https://[PROJECT_ID].supabase.co/rest/v1/"
SUPABASE_PUBLIC_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── Passwords ─────────────────────────────────────────────────
ADMIN_PASSWORD="change_me_admin_2024!"
MOD_PASSWORD="change_me_mod_2024!"

# ── Redis (Master node — container nội bộ) ───────────────────
REDIS_URL="redis://redis:6379/0"

# ── Kafka / Redpanda ─────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS="redpanda:9092"

# ── Cookie & Security ─────────────────────────────────────────
# true trên HTTPS production
DEVICE_COOKIE_SECURE="true"

# ── WebSocket Allowed Origins ─────────────────────────────────
WS_ALLOWED_ORIGINS="https://checkinface.me,https://www.checkinface.me,https://face-recognition-system-coral.vercel.app,http://localhost:3000,http://127.0.0.1:3000"

# ── Presence Lease ────────────────────────────────────────────
CAMERA_PRESENCE_TTL_SECONDS=15
CAMERA_PRESENCE_RENEW_SECONDS=5

# ── Pairing ───────────────────────────────────────────────────
PAIRING_CODE_TTL_SECONDS=600
PAIRING_CLAIM_LIMIT=10
PAIRING_CLAIM_WINDOW_SECONDS=600

# ── Frame Size ────────────────────────────────────────────────
MAX_CAMERA_FRAME_BYTES=2097152

# ── AI Model ─────────────────────────────────────────────────
RECOGNIZER_MODEL=edgeface

# ── Threading (tối ưu cho t3.micro 2 vCPU) ───────────────────
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
MKL_NUM_THREADS=2
ONNX_INTRA_OP_NUM_THREADS=2
